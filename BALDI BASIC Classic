addConn(RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            if healthLockBaldi or healthLockTheJ then
                hum.Health = hum.MaxHealth
            end
            if speedBaldiState then
                hum.WalkSpeed = 45
            elseif speedTheJState then
                hum.WalkSpeed = 50
            end
            if jumpTheJState then
                hum.JumpPower = 100
            end
        end
    end
end))

-- Throttled Background Task
task.spawn(function()
    while _G.EvilSessionToken == currentSession do
        task.wait(0.3)
        
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")

        -- 1. Aura Kill
        if auraKillState and root then
            for _, model in pairs(Workspace:GetDescendants()) do
                if model:IsA("Model") and model ~= char then
                    local enemyHum = model:FindFirstChildOfClass("Humanoid")
                    local enemyRoot = model:FindFirstChild("HumanoidRootPart")
                    if enemyHum and enemyRoot and enemyHum.Health > 0 then
                        if (enemyRoot.Position - root.Position).Magnitude < 25 then
                            enemyHum.Health = 0
                        end
                    end
                end
            end
        end

        -- 2. Freeze Baldi
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj.Name:lower():find("baldi") and obj:IsA("Model") then
                for _, part in pairs(obj:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.Anchored = freezeBaldiState
                    end
                end
            end
        end

        -- 3. ESP Baldi & Playtime
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") then
                local nameLower = obj.Name:lower()
                
                if espBaldiState and nameLower:find("baldi") then
                    if not obj:FindFirstChild("BaldiESP") then
                        local hl = Instance.new("Highlight")
                        hl.Name = "BaldiESP"
                        hl.FillColor = Color3.fromRGB(255, 0, 0)
                        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                        hl.Parent = obj
                    end
                elseif not espBaldiState and obj:FindFirstChild("BaldiESP") then
                    obj.BaldiESP:Destroy()
                end

                if espPlaytimeState and (nameLower:find("playtime") or nameLower:find("play_time")) then
                    if not obj:FindFirstChild("PlaytimeESP") then
                        local hl = Instance.new("Highlight")
                        hl.Name = "PlaytimeESP"
                        hl.FillColor = Color3.fromRGB(255, 165, 0)
                        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                        hl.Parent = obj
                    end
                elseif not espPlaytimeState and obj:FindFirstChild("PlaytimeESP") then
                    obj.PlaytimeESP:Destroy()
                end
            end
        end
    end
end)

