    btn.Text = text
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 13
    btn.Parent = parent
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    addConn(btn.MouseButton1Click:Connect(function()
        callback(btn)
    end))
    return btn
end

